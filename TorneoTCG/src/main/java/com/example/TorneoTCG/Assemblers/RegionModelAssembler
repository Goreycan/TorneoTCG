package com.example.TorneoTCG.Assemblers;

import static org.springframework.hateoas.server.mvc.WebMvcLinkBuilder.linkTo;
import static org.springframework.hateoas.server.mvc.WebMvcLinkBuilder.methodOn;

import org.springframework.hateoas.EntityModel;
import org.springframework.hateoas.server.RepresentationModelAssembler;
import org.springframework.stereotype.Component;

import com.example.TorneoTCG.controller.RegionController;
import com.example.TorneoTCG.model.Region;

@Component

public class RegionModelAssembler implements RepresentationModelAssembler<Region, EntityModel<Region>> {

    @Override
    public EntityModel<Region> toModel(Region region) {
        return EntityModel.of(region,
                linkTo(methodOn(RegionController.class).obtenerPorId(region.getId())).withSelfRel(),
                linkTo(methodOn(RegionController.class).obtenerTodos()).withRel("regiones"));
    }

}
